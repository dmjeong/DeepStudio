<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Deep Vision Studio" Manufacturer="Deep Vision Studio" Version="$(var.Version)"
           UpgradeCode="9B5C5E1E-6C0B-4BB9-AE9B-2A0A1B6D2C8A" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer Deep Vision Studio is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DeepVisionStudio" />
    </StandardDirectory>
    <Feature Id="MainFeature" Title="Deep Vision Studio" Level="1">
      <ComponentGroupRef Id="PayloadFiles" />
    </Feature>

<?if $(var.RequireOfflineWsl) = 1 ?>
    <SetProperty Id="WixQuietExecCmdLine"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]runtime\wsl\bootstrap_wsl.ps1&quot; -PayloadRoot &quot;[INSTALLFOLDER]runtime\wsl&quot; -DistroName &quot;DeepVisionStudio&quot; -StateRoot &quot;[LocalAppDataFolder]DeepVisionStudio\wsl&quot; -Version &quot;$(var.Version)&quot;"
        Before="RunDeepVisionWslBootstrap" Sequence="execute" />
    <CustomAction Id="RunDeepVisionWslBootstrap"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec" Execute="deferred" Impersonate="yes" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="RunDeepVisionWslBootstrap" After="InstallFiles">NOT REMOVE</Custom>
    </InstallExecuteSequence>
<?endif?>
  </Package>

  <Fragment>
    <ComponentGroup Id="PayloadFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PayloadRoot)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
